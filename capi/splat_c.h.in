#ifndef SPLAT_C_H
#define SPLAT_C_H

#include <stddef.h>
#include <stdint.h>

#if defined(_WIN32) && defined(SPLAT_C_SHARED)
#if defined(splat_c_EXPORTS)
#define SPLAT_C_API __declspec(dllexport)
#else
#define SPLAT_C_API __declspec(dllimport)
#endif
#elif defined(__GNUC__) || defined(__clang__)
#define SPLAT_C_API __attribute__((visibility("default")))
#else
#define SPLAT_C_API
#endif

#define SPLAT_C_VERSION_MAJOR @PROJECT_VERSION_MAJOR @
#define SPLAT_C_VERSION_MINOR @PROJECT_VERSION_MINOR @
#define SPLAT_C_VERSION_PATCH @PROJECT_VERSION_PATCH @
#define SPLAT_C_VERSION "@PROJECT_VERSION@"

#define SPLAT_C_INVALID_COLUMN_INDEX (-1)

#ifdef __cplusplus
extern "C" {
#endif

typedef struct splat_c_table splat_c_table;
typedef struct splat_c_table_array splat_c_table_array;

typedef enum splat_c_status {
  SPLAT_C_STATUS_OK = 0,
  SPLAT_C_STATUS_INVALID_ARGUMENT = 1,
  SPLAT_C_STATUS_OUT_OF_RANGE = 2,
  SPLAT_C_STATUS_UNSUPPORTED_FORMAT = 3,
  SPLAT_C_STATUS_RUNTIME_ERROR = 4
} splat_c_status;

typedef enum splat_c_column_type {
  SPLAT_C_COLUMN_TYPE_INT8 = 0,
  SPLAT_C_COLUMN_TYPE_UINT8 = 1,
  SPLAT_C_COLUMN_TYPE_INT16 = 2,
  SPLAT_C_COLUMN_TYPE_UINT16 = 3,
  SPLAT_C_COLUMN_TYPE_INT32 = 4,
  SPLAT_C_COLUMN_TYPE_UINT32 = 5,
  SPLAT_C_COLUMN_TYPE_FLOAT32 = 6,
  SPLAT_C_COLUMN_TYPE_FLOAT64 = 7
} splat_c_column_type;

/**
 * Optional configuration for `splat_c_write()`.
 *
 * For SOG output, `sog_iterations <= 0` uses the default value `10`.
 * `sog_bundle = -1` infers the mode from the extension (`.sog` = bundled,
 * `meta.json` = unbundled directory layout). Other formats ignore these fields.
 */
typedef struct splat_c_write_options {
  int32_t sog_iterations;
  int32_t sog_bundle;
} splat_c_write_options;

#define SPLAT_C_WRITE_OPTIONS_INIT {10, -1}

/**
 * Return the configured library version string.
 *
 * The returned pointer is process-lifetime static data.
 */
SPLAT_C_API const char* splat_c_version(void);

/**
 * Return the last error message for the current thread.
 *
 * The returned pointer remains valid until the next C API call on the same thread.
 * An empty string means no error has been recorded.
 */
SPLAT_C_API const char* splat_c_last_error_message(void);

/**
 * Write a table to disk.
 *
 * Supported output names currently include `.csv`, `.splat`, `.sog`,
 * `meta.json`, `.ply`, and `.glb`. Pass `NULL` for `options` to use the
 * default behavior.
 */
SPLAT_C_API splat_c_status splat_c_write(const splat_c_table* table, const char* filename,
                                         const splat_c_write_options* options);

/**
 * Read a splat file and return one or more opaque tables.
 *
 * Supported extensions currently include `.splat`, `.ksplat`, `.sog`, `meta.json`,
 * `.ply`, and `.spz`. The caller owns the returned array and must release it with
 * `splat_c_table_array_destroy()`.
 */
SPLAT_C_API splat_c_status splat_c_read(const char* filename, splat_c_table_array** out_tables);

/**
 * Destroy an array returned by `splat_c_read()`.
 *
 * Passing `NULL` is allowed.
 */
SPLAT_C_API void splat_c_table_array_destroy(splat_c_table_array* tables);

/**
 * Return the number of tables in an array returned by `splat_c_read()`.
 */
SPLAT_C_API splat_c_status splat_c_table_array_size(const splat_c_table_array* tables, size_t* out_size);

/**
 * Return a table handle at `index`.
 *
 * The returned pointer is owned by `tables` and remains valid until `tables` is
 * destroyed. Do not pass this borrowed handle to `splat_c_table_destroy()`.
 */
SPLAT_C_API splat_c_status splat_c_table_array_get(const splat_c_table_array* tables, size_t index,
                                                   const splat_c_table** out_table);

/**
 * Destroy an owned table handle returned by clone or op APIs.
 *
 * Do not use this on borrowed handles returned by `splat_c_table_array_get()`.
 * Passing `NULL` is allowed.
 */
SPLAT_C_API void splat_c_table_destroy(splat_c_table* table);

/**
 * Create an empty owned table.
 *
 * The caller owns the returned table and must release it with
 * `splat_c_table_destroy()`.
 */
SPLAT_C_API splat_c_status splat_c_table_create(splat_c_table** out_table);

/**
 * Deep-copy a table into a new owned handle.
 *
 * The caller owns the returned table and must release it with
 * `splat_c_table_destroy()`.
 */
SPLAT_C_API splat_c_status splat_c_table_clone(const splat_c_table* table, splat_c_table** out_table);

/**
 * Deep-copy either all columns or a named subset into a new owned handle.
 *
 * If `column_count` is zero, the full table is cloned and `column_names` may be
 * `NULL`. Otherwise each entry in `column_names` must be a non-empty string.
 */
SPLAT_C_API splat_c_status splat_c_table_clone_columns(const splat_c_table* table, const char* const* column_names,
                                                       size_t column_count, splat_c_table** out_table);

/**
 * Return the row count for a table.
 */
SPLAT_C_API splat_c_status splat_c_table_num_rows(const splat_c_table* table, size_t* out_rows);

/**
 * Return the column count for a table.
 */
SPLAT_C_API splat_c_status splat_c_table_num_columns(const splat_c_table* table, size_t* out_columns);

/**
 * Look up a column by name.
 *
 * On success, `out_index` is set to the zero-based column index or
 * `SPLAT_C_INVALID_COLUMN_INDEX` if the column does not exist.
 */
SPLAT_C_API splat_c_status splat_c_table_column_index(const splat_c_table* table, const char* name, int32_t* out_index);

/**
 * Return whether a named column exists.
 *
 * `out_has_column` is set to `1` when present and `0` otherwise.
 */
SPLAT_C_API splat_c_status splat_c_table_has_column(const splat_c_table* table, const char* name,
                                                    int32_t* out_has_column);

/**
 * Return the name of a column.
 *
 * The returned string is owned by `table` and remains valid while the table is alive.
 */
SPLAT_C_API splat_c_status splat_c_table_column_name(const splat_c_table* table, size_t column_index,
                                                     const char** out_name);

/**
 * Return the typed storage kind for a column.
 */
SPLAT_C_API splat_c_status splat_c_table_column_type(const splat_c_table* table, size_t column_index,
                                                     splat_c_column_type* out_type);

/**
 * Return the element count for a column.
 */
SPLAT_C_API splat_c_status splat_c_table_column_length(const splat_c_table* table, size_t column_index,
                                                       size_t* out_length);

/**
 * Return the size in bytes of one column element.
 */
SPLAT_C_API splat_c_status splat_c_table_column_element_size(const splat_c_table* table, size_t column_index,
                                                             size_t* out_element_size);

/**
 * Return a read-only pointer to the raw column storage.
 *
 * The returned pointer is owned by `table` and remains valid while the table is
 * alive. `out_size_bytes` may be `NULL`.
 */
SPLAT_C_API splat_c_status splat_c_table_column_data(const splat_c_table* table, size_t column_index,
                                                     const void** out_data, size_t* out_size_bytes);

/**
 * Add a new column to a mutable table.
 *
 * `data` may be `NULL`, in which case the column is zero-initialized. Column names
 * must be unique within the table. For non-empty tables, `length` must match the
 * existing row count.
 */
SPLAT_C_API splat_c_status splat_c_table_add_column(splat_c_table* table, const char* name, splat_c_column_type type,
                                                    size_t length, const void* data);

/**
 * Remove a column by name from a mutable table.
 *
 * `out_removed` is set to `1` when a column was removed and `0` when the name was
 * not present.
 */
SPLAT_C_API splat_c_status splat_c_table_remove_column(splat_c_table* table, const char* name, int32_t* out_removed);

/**
 * Replace the raw storage of an existing column.
 *
 * `size_bytes` must exactly match the column byte size. `data` may be `NULL` only
 * when `size_bytes` is zero.
 */
SPLAT_C_API splat_c_status splat_c_table_column_copy_data(splat_c_table* table, size_t column_index, const void* data,
                                                          size_t size_bytes);

/**
 * Read one element and convert it to `double`.
 */
SPLAT_C_API splat_c_status splat_c_table_column_value_as_double(const splat_c_table* table, size_t column_index,
                                                                size_t row_index, double* out_value);

/**
 * Write one element from a `double`, using the column's native conversion rules.
 */
SPLAT_C_API splat_c_status splat_c_table_column_set_value_from_double(splat_c_table* table, size_t column_index,
                                                                      size_t row_index, double value);

/**
 * Transform a table and return the transformed copy.
 *
 * Rotation quaternion components use `(w, x, y, z)` order. `uniform_scale` must be
 * greater than zero because scale columns are stored in log space.
 */
SPLAT_C_API splat_c_status splat_c_table_transform(const splat_c_table* table, float translation_x, float translation_y,
                                                   float translation_z, float rotation_w, float rotation_x,
                                                   float rotation_y, float rotation_z, float uniform_scale,
                                                   splat_c_table** out_table);

/**
 * Combine multiple tables into a single new table.
 *
 * Input handles are borrowed and remain owned by the caller.
 */
SPLAT_C_API splat_c_status splat_c_tables_combine(const splat_c_table* const* tables, size_t table_count,
                                                  splat_c_table** out_table);

/**
 * Fill `out_indices` with a Morton-sorted permutation of row indices.
 *
 * `index_count` must equal the table row count.
 */
SPLAT_C_API splat_c_status splat_c_table_compute_morton_order(const splat_c_table* table, uint32_t* out_indices,
                                                              size_t index_count);

/**
 * Fill `out_indices` with a visibility-sorted permutation of row indices.
 *
 * Visibility is sorted from most visible to least visible. `index_count` must equal
 * the table row count.
 */
SPLAT_C_API splat_c_status splat_c_table_compute_visibility_order(const splat_c_table* table, uint32_t* out_indices,
                                                                  size_t index_count);

/**
 * Reorder a table according to `indices` and return a new owned table.
 *
 * `indices` may describe any output order supported by `SplatCloud::permuteRows`,
 * including subsets or duplicated rows.
 */
SPLAT_C_API splat_c_status splat_c_table_reorder(const splat_c_table* table, const uint32_t* indices,
                                                 size_t index_count, splat_c_table** out_table);

/**
 * Simplify a table toward `target_count` rows and return a new owned table.
 */
SPLAT_C_API splat_c_status splat_c_table_simplify(const splat_c_table* table, int32_t target_count,
                                                  splat_c_table** out_table);

#ifdef __cplusplus
}
#endif

#endif  // SPLAT_C_H
